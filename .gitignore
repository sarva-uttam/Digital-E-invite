# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Archives and local backups
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -----------------------------------------------------------------------------
# Local exports containing customer, guest, payment or audit data
# Never commit production data exports, even in a private repository.
# -----------------------------------------------------------------------------
exports/
data-exports/
database-dumps/
backups/

*.dump
*.sql.gz
*.csv.local
*.tsv.local
*.jsonl.local

# -----------------------------------------------------------------------------
# Security and scanning output
# -----------------------------------------------------------------------------
.scannerwork/
.sonar/
security-reports/
dependency-reports/
sbom.local.*

# -----------------------------------------------------------------------------
# Patch, merge and rejected-change artifacts
# -----------------------------------------------------------------------------
*.rej
*.patch.local

# Intentionally NOT ignored:
# - dependency lockfiles;
# - database migrations;
# - reviewed infrastructure source;
# - .env.example;
# - approved documentation;
# - fixtures that contain no secrets or real customer/guest data.
