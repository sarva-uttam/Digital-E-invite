temp/
.tmp/

generated/
generated-assets/
generated-media/
ai-output/
ai-outputs/

# -----------------------------------------------------------------------------
# IDE, editor and AI-tool local state
# Preserve shared workspace settings only when explicitly approved.
# -----------------------------------------------------------------------------
.idea/
.fleet/
.history/
*.code-workspace

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
