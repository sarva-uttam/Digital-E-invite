# AI Digital Invitation Platform
# Approved baseline — 2026-08-17
#
# Provider-neutral baseline. Extend this file only when an approved stack or
# authorized tool introduces a generated or local-only artifact.
# Do not use ignore rules as a substitute for removing a committed secret.

# -----------------------------------------------------------------------------
# Environment variables and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

*.local
*.local.*
config.local.*

# -----------------------------------------------------------------------------
# Secrets, credentials, certificates and signing material
# -----------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.cer
*.crt
*.der
*.csr

credentials.json
credentials.*.json
service-account*.json
service_account*.json
secrets.json
secrets.*.json

# -----------------------------------------------------------------------------
# Logs, diagnostics and runtime traces
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log

*.pid
*.pid.lock
*.seed
*.stackdump

# -----------------------------------------------------------------------------
# Dependency directories and package-manager caches
# Keep lockfiles committed after an ecosystem is approved.
# -----------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.npm/
.pnpm-store/

vendor/

