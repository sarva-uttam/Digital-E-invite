# AI Digital Invitation Platform
# Approved baseline — 2026-08-17
#
# This file is a provider-neutral configuration contract, not a production
# configuration. Copy it to an ignored environment file only after the relevant
# stack decision has been approved.
#
# Safety rules:
# - Never place real credentials in this file or commit them to Git.
# - Blank values mean "not configured"; the application must fail safely.
# - Server secrets must never use a PUBLIC_ prefix or reach browser bundles.
# - Production secrets must come from the approved secret-management system.
# - Remove obsolete variables when their integrations are retired.

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=AI Digital Invitation Platform
APP_URL=
PUBLIC_APP_URL=
APP_TIMEZONE=Indian/Mauritius
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=MUR
LOG_LEVEL=info

# Comma-separated values. Final production origins must be explicit.
ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=

# -----------------------------------------------------------------------------
# Application security
# Generate independent, high-entropy values. Never reuse keys across purposes.
# -----------------------------------------------------------------------------
APP_SECRET=
ENCRYPTION_KEY=
TOKEN_HASH_KEY=

# -----------------------------------------------------------------------------
# Database
# Do not point development, preview or test environments at production data.
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_SSL_MODE=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=

# -----------------------------------------------------------------------------
# Authentication and sessions
# Provider-specific variables may be added only after provider approval.
# -----------------------------------------------------------------------------
AUTH_PROVIDER=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_AUDIENCE=
SESSION_COOKIE_NAME=
SESSION_TTL_SECONDS=

# -----------------------------------------------------------------------------
# Object storage and user-uploaded media
# Buckets and credentials must be isolated by environment.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# AI text generation
# Model identifiers and provider limits are deployment configuration, not
# product entitlements. No silent cross-provider fallback is implied.
# -----------------------------------------------------------------------------
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
AI_TEXT_API_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# AI image generation
# Keep image and text credentials separate even if one provider supplies both.
# -----------------------------------------------------------------------------
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# Payments
# Use sandbox credentials outside production. Browser state, redirects and
# client-provided amounts are never proof of payment.
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_MODE=sandbox
PAYMENT_API_BASE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_BASE_CURRENCY=MUR
PAYMENT_SUPPORTED_CURRENCIES=MUR

# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_ADDRESS=

# -----------------------------------------------------------------------------
# Cache, queues and scheduled work
# Leave blank when the approved architecture does not require the service.
# -----------------------------------------------------------------------------
CACHE_URL=
QUEUE_URL=
SCHEDULER_SECRET=

# -----------------------------------------------------------------------------
# Observability
# Logs and traces must not contain invitation secrets, guest personal data,
# payment credentials, raw AI prompts containing sensitive data, or tokens.
# -----------------------------------------------------------------------------
ERROR_REPORTING_DSN=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# -----------------------------------------------------------------------------
# Feature gates
# Optional or externally dependent capabilities fail closed by default.
# These gates do not replace server-side authorization or entitlements.
# -----------------------------------------------------------------------------
ENABLE_PAYMENTS=false
ENABLE_AI_TEXT=false
ENABLE_AI_IMAGE=false
ENABLE_EMAIL_DELIVERY=false
ENABLE_EUR_CHECKOUT=false
ENABLE_USD_CHECKOUT=false
ENABLE_MAURITIAN_KREOL=false
ENABLE_RUSSIAN=false

# -----------------------------------------------------------------------------
# Local development and automated tests
# Test values must still be synthetic and non-sensitive.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=
E2E_BASE_URL=

# -----------------------------------------------------------------------------
# Intentionally absent until architecture or provider approval
# -----------------------------------------------------------------------------
# - framework-specific public environment variables;
# - direct MCB Juice, SBM Tag, MauCAS or blink credentials;
# - provider-specific AI, authentication, database or hosting variables;
# - production tax rates, prices, entitlements or commercial limits;
# - real domains, account identifiers, tokens, keys or secrets.
