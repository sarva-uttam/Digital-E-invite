{
  "name": "ai-digital-invitation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Digital Invitation Platform — Next.js web application (engineering baseline).",
  "engines": {
    "node": "24.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "6.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
